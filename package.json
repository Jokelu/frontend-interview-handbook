{
  "name": "fe-interview-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "前端高频面试题实战手册 - Vue3 + TypeScript",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-content.mjs && vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.469.0",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
